# Lambda container cho pronunciation scorer (wav2vec2 + xlsr GOP).
# Build tu backend/: docker build -f docker/Dockerfile.scorer -t eroom-scorer .
FROM public.ecr.aws/lambda/python:3.13

# libsndfile cho soundfile. Log cua app ghi ra file -> symlink sang /tmp
# (Lambda chi ghi duoc /tmp).
RUN dnf install -y libsndfile && dnf clean all && \
    mkdir -p /tmp/log /opt/nltk_data /opt/hf_cache && \
    ln -sfn /tmp/log /var/task/log

ENV HF_HOME=/opt/hf_cache \
    NLTK_DATA=/opt/nltk_data \
    OMP_NUM_THREADS=4 \
    APP_ENV=development \
    SECRET_KEY=lambda-dummy \
    SCORER_BACKEND=local

COPY docker/scorer-requirements.txt /tmp/scorer-requirements.txt
RUN pip install --no-cache-dir -r /tmp/scorer-requirements.txt \
    --extra-index-url https://download.pytorch.org/whl/cpu

# Bake NLTK data + HF weights vao image (runtime khong tai gi them).
RUN python -c "import nltk; nltk.download('cmudict', download_dir='/opt/nltk_data')" && \
    python -c "from transformers import Wav2Vec2ForCTC, Wav2Vec2Processor, AutoFeatureExtractor; \
        [Wav2Vec2ForCTC.from_pretrained(m) for m in ['facebook/wav2vec2-base-960h', 'facebook/wav2vec2-xlsr-53-espeak-cv-ft']]; \
        Wav2Vec2Processor.from_pretrained('facebook/wav2vec2-base-960h'); \
        AutoFeatureExtractor.from_pretrained('facebook/wav2vec2-xlsr-53-espeak-cv-ft')"

# Copy toan bo app de import parity voi backend (image van duoi 10GB).
COPY app/ ${LAMBDA_TASK_ROOT}/app/
COPY docker/scorer_handler.py ${LAMBDA_TASK_ROOT}/scorer_handler.py

CMD ["scorer_handler.handler"]
