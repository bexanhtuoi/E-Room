# NOTE: .env, .env.docker, .env.example phải sync nhau — biến nào config.py
# đọc thì cả 3 file đều phải có, không dư không thiếu.

# App
APP_NAME=E-Room API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DESCRIPTION=Realtime English speaking rooms with AI support
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Auth
SECRET_KEY=change-me-32-characters-minimum-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Database
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=4000
DB_NAME=ERoom
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
LLM_BASE_URL=http://localhost:8012/v1
LLM_MODEL=gemma-4-E2B-it
LLM_API_KEY=
LLM_CALL_TIMEOUT_SECONDS=120
AI_TIMEOUT_SECONDS=900
AI_SOFT_TIMEOUT_SECONDS=840
AI_QUEUE_NAME=ai
AI_OBSERVER_QUEUE_NAME=ai_observer
AI_TRANSCRIBER_QUEUE_NAME=ai_transcriber
AI_MAX_CONCURRENCY=0

# Embedding
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_API_KEY=ollama

# Reranker
RERANKER_MODEL=ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF
RERANKER_BASE_URL=http://localhost:8014
RERANKER_API_KEY=not-needed

# STT — auto (khuyen dung): whisper host (:8001) song thi dung host
# (large-v3-turbo, GPU), chet thi fallback whisper local cu (small, CPU).
# May AI mo firewall 8001/8002; may nay tro sang IP TAILSCALE cua may AI:
#   STT_SERVER_BASE_URL=http://100.x.y.z:8001/v1   (xem IP bang `tailscale ip -4` tren may AI)
# Ep cung: STT_PROVIDER=whisper_server (chi host) | faster_whisper (chi local).
# Cloud fallback (tuy chon): khi hang doi STT nghe tac (>=4 job cho) se tran sang cloud.
STT_PROVIDER=auto
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=2
STT_BEAM_SIZE=3
STT_SERVER_ALIVE_TIMEOUT=3.0
STT_SERVER_ALIVE_TTL=60.0
STT_LANGUAGE=en
STT_CLOUD_API_KEY=
STT_CLOUD_BASE_URL=https://api.openai.com/v1
STT_CLOUD_MODEL=whisper-1
STT_SERVER_BASE_URL=http://localhost:8001/v1
STT_SERVER_API_KEY=cant-be-empty
STT_SERVER_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo
STT_SERVER_TIMEOUT=30.0

# TTS Kokoro (:8002). Voice: af_heart (nu My, default) | am_adam (nam My)
#   bf_emma (nu Anh) | bm_george (nam Anh). Speed 0.9 = vua nhu nguoi noi.
# May kia goi sang may AI qua Tailscale: sua dong duoi thanh
# TTS_BASE_URL=http://100.x.y.z:8002/v1 (IP Tailscale cua may AI).
TTS_BASE_URL=http://localhost:8002/v1
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_SPEED=0.9
TTS_TIMEOUT=30.0
# Pronun scorer — demo/pronun-app (:8005) chay tren MAY AI (cung may STT/TTS).
# De trong = dung heuristic noi bo (khong can may AI). Co URL = cham that:
#   PRONUN_BASE_URL=http://100.x.y.z:8005            (may AI o may khac, qua Tailscale)
#   PRONUN_BASE_URL=http://host.docker.internal:8005 (backend chay docker, AI chay ngoai cung may)
PRONUN_BASE_URL=
PRONUN_TIMEOUT=300.0
# Ruot scorer local trong backend (may chay backend gánh compute).
# Model tai 1 lan vao HF cache (~0.4GB wav2vec2 + ~1.2GB xlsr phoneme).
WAV2VEC_MODEL_ID=facebook/wav2vec2-base-960h
PHONEME_MODEL_ID=facebook/wav2vec2-xlsr-53-espeak-cv-ft
# May host web yeu (3-4 nguoi cham cung luc): 1 = cham tuan tu, tranh OOM.
SCORING_MAX_PARALLEL=1
# AI feedback (chi doc ScoringReport, khong sua diem) — dung LLM local
# (LLM_BASE_URL/LLM_MODEL), khong can key rieng.
SPEECH_LOG_DIR=log/speech
SPEECH_LOG_SAVE_AUDIO=true
# Raw attempt recording (song song VAD, ghi TOÀN BỘ audio liên tục cho forced-alignment)
SPEECH_RAW_ENABLED=true
SPEECH_RAW_END_SILENCE_SECONDS=8.0
SPEECH_RAW_MAX_ATTEMPT_SECONDS=300.0
SPEECH_RAW_FLUSH_BYTES=65536
STT_VAD_SILENCE_SECONDS=2.0
STT_VAD_MIN_SPEECH_SECONDS=0.5
STT_VAD_MAX_SPEECH_SECONDS=20.0
STT_VAD_ENERGY_THRESHOLD=0.01

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=embedded_documents

# Search
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# LiveKit
LIVEKIT_MODE=local
LIVEKIT_LOCAL_URL=ws://localhost:7880
LIVEKIT_LOCAL_API_KEY=devkey
LIVEKIT_LOCAL_API_SECRET=dev-secret-change-me-32-characters
LIVEKIT_CLOUD_URL=wss://xxx.livekit.cloud
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eroom
MINIO_SECURE=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Heartbeat
HEARTBEAT_INTERVAL_SECONDS=45
ROOM_EMPTY_END_SECONDS=86400

# Logging
LOG_LEVEL=INFO
LOG_FILE=log/app.log
