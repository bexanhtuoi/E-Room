# NOTE: .env, .env.docker, .env.example phai sync nhau — bien nao config.py
# doc thi ca 3 file deu phai co, khong du khong thieu.
# Quy uoc comment: chi 1 dong '# Ten nhom' truoc moi nhom bien, khong comment
# lung tung trong file nay — dien giai chi tiet doc README.md (bang bien) va docs/setup.md.

# App
APP_NAME=E-Room API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DESCRIPTION=Realtime English speaking rooms with AI support
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Auth
SECRET_KEY=change-me-32-characters-minimum-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS=20
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_ATTEMPTS=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

# Database
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=4000
DB_NAME=ERoom
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM
LLM_BASE_URL=http://localhost:8012/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_API_KEY=
LLM_CALL_TIMEOUT_SECONDS=120
AI_TIMEOUT_SECONDS=900
AI_SOFT_TIMEOUT_SECONDS=840
AI_QUEUE_NAME=ai
AI_OBSERVER_QUEUE_NAME=ai_observer
AI_TRANSCRIBER_QUEUE_NAME=ai_transcriber
AI_MAX_CONCURRENCY=0

# Embedding
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_API_KEY=ollama

# Reranker
RERANKER_MODEL=ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF
RERANKER_BASE_URL=http://localhost:8014
RERANKER_API_KEY=not-needed

# HuggingFace
HF_HUB_DISABLE_XET=1

# Performance
OMP_NUM_THREADS=4

# STT
STT_PROVIDER=auto
STT_MODEL_SIZE=small
STT_LANGUAGE=en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=2
STT_BEAM_SIZE=3
STT_SERVER_BASE_URL=http://localhost:8001/v1
STT_SERVER_API_KEY=cant-be-empty
STT_SERVER_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo
STT_SERVER_TIMEOUT=30.0
STT_LOCAL_ENABLED=true
STT_SERVER_ALIVE_TIMEOUT=3.0
STT_SERVER_ALIVE_TTL=60.0
STT_CLOUD_API_KEY=
STT_CLOUD_BASE_URL=https://api.openai.com/v1
STT_CLOUD_MODEL=whisper-1

# TTS
TTS_BASE_URL=http://localhost:8002/v1
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_SPEED=0.9
TTS_TIMEOUT=30.0

# Pronunciation scoring
PRONUN_BASE_URL=
PRONUN_TIMEOUT=300.0
WAV2VEC_MODEL_ID=facebook/wav2vec2-base-960h
PHONEME_MODEL_ID=facebook/wav2vec2-xlsr-53-espeak-cv-ft
SCORING_MAX_PARALLEL=1

# Speech log
SPEECH_LOG_DIR=log/speech
SPEECH_LOG_SAVE_AUDIO=true
SPEECH_RAW_ENABLED=true
SPEECH_RAW_END_SILENCE_SECONDS=8.0
SPEECH_RAW_MAX_ATTEMPT_SECONDS=300.0
SPEECH_RAW_FLUSH_BYTES=65536
SPEECH_RETENTION_DAYS=30
STT_VAD_SILENCE_SECONDS=2.0
STT_VAD_MIN_SPEECH_SECONDS=0.5
STT_VAD_MAX_SPEECH_SECONDS=20.0
STT_VAD_ENERGY_THRESHOLD=0.01
STT_VAD_THRESHOLD=0.5

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=embedded_documents

# Search
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# LiveKit
LIVEKIT_MODE=local
LIVEKIT_LOCAL_URL=ws://localhost:7880
LIVEKIT_LOCAL_API_KEY=devkey
LIVEKIT_LOCAL_API_SECRET=dev-secret-change-me-32-characters
LIVEKIT_CLOUD_URL=wss://xxx.livekit.cloud
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eroom
MINIO_SECURE=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Heartbeat
HEARTBEAT_INTERVAL_SECONDS=45
ROOM_EMPTY_END_SECONDS=86400

# Logging
LOG_LEVEL=INFO
LOG_FILE=log/app.log
