# ============================================================================
# E-Room backend env — copy file nay thanh `.env` (dev local) roi sua.
# Container docker doc `.env.docker` (rieng). Khong commit file co secret that.
# ============================================================================

# --- App ---
APP_NAME=E-Room API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
# Nhieu origin cach nhau dau phay. Public qua Tailscale thi them domain ts.net
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Database TiDB ---
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=4000
DB_NAME=ERoom
# Hoac ghi de full URL (docker compose dung cai nay):
# DATABASE_URL=mysql+pymysql://root:@tidb:4000/ERoom

# --- Redis ---
# Local: redis://localhost:6379/0 | Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT (DOI SECRET truoc khi public!) ---
SECRET_KEY=change-me-32-characters-minimum-please
ALGORITHM=HS256
# Session 7 ngay = 10080 phut
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Google OAuth (Login with Google) ---
# Can OAuth Client ID (KHONG dung service-account credentials.json).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# --- LLM (chat @ai) ---
# Local llama.cpp: http://localhost:8012/v1 (may that) | Docker: http://llama:8012/v1
LLM_BASE_URL=http://localhost:8012/v1
LLM_MODEL=gemma-4-E2B-it
LLM_API_KEY=
# Tra loi AI toi da 15 phut (hard). Soft kem 1 phut de kip dang cau xin loi.
AI_TIMEOUT_SECONDS=900
AI_SOFT_TIMEOUT_SECONDS=840
AI_QUEUE_NAME=ai
AI_OBSERVER_QUEUE_NAME=ai_observer
AI_TRANSCRIBER_QUEUE_NAME=ai_transcriber
# 0 = khong gioi han Redis, >0 = gioi han N job AI song song toan he thong
AI_MAX_CONCURRENCY=0

# --- Embedding (RAG) ---
# Local Ollama: http://localhost:11434/v1 (may that) | Docker: http://ollama:11434/v1
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_API_KEY=ollama

# --- Reranker (RAG) ---
# Local llama.cpp: http://localhost:8014 (may that) | Docker: http://reranker:8014
RERANKER_MODEL=ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF
RERANKER_BASE_URL=http://localhost:8014
RERANKER_API_KEY=not-needed

# --- STT (voice -> text). Local = khong can API key ---
STT_PROVIDER=faster_whisper
STT_MODEL_SIZE=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Cloud (OpenAI/Groq tuong thich): dien key thi doi PROVIDER
STT_CLOUD_API_KEY=
STT_CLOUD_BASE_URL=https://api.openai.com/v1
STT_CLOUD_MODEL=whisper-1
STT_VAD_SILENCE_SECONDS=2.0
STT_VAD_MIN_SPEECH_SECONDS=0.5
STT_VAD_MAX_SPEECH_SECONDS=20.0
STT_VAD_ENERGY_THRESHOLD=0.01

# --- Qdrant (vector DB tai lieu) ---
# Local: localhost | Docker: qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=embedded_documents

# --- Web search cho agent (trong thi agent tu bo qua, van tra loi) ---
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# === LiveKit: chon cum bang LIVEKIT_MODE (local|cloud), khong dao comment ===
LIVEKIT_MODE=local
# --- Cum LOCAL (mac dinh) — server LiveKit chay docker, tot cho LAN/dev.
# Yeu cau mo port UDP moi goi duoc tu ngoai internet.
# KEY/SECRET phai khop backend/livekit.yaml
LIVEKIT_LOCAL_URL=ws://localhost:7880
LIVEKIT_LOCAL_API_KEY=devkey
LIVEKIT_LOCAL_API_SECRET=dev-secret-change-me-32-characters
# --- Cum CLOUD (khuyen nghi khi public) — media qua TURN cua Cloud,
# khong can mo port, khong can IP tinh. Dang ky free o cloud.livekit.io
# roi dien 3 dong duoi + doi LIVEKIT_MODE=cloud.
LIVEKIT_CLOUD_URL=wss://xxx.livekit.cloud
LIVEKIT_CLOUD_API_KEY=
LIVEKIT_CLOUD_API_SECRET=
# (Webhook Cloud la optional — presence goi direct, khong phu thuoc webhook.)

# --- MinIO (S3 files) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eroom
MINIO_SECURE=false

# --- Stripe (subscription, optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Heartbeat + lifecycle phong ---
HEARTBEAT_INTERVAL_SECONDS=45
# Phong trong bao lau thi ENDED (giay, mac dinh 24h)
ROOM_EMPTY_END_SECONDS=86400

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=log/app.log
