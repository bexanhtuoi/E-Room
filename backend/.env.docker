APP_NAME=E-Room API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=https://localhost:3000

DATABASE_URL=mysql+pymysql://root:@tidb:4000/ERoom
REDIS_URL=redis://redis:6379/0

QDRANT_HOST=qdrant
QDRANT_PORT=6333

ROOM_EMPTY_END_SECONDS=86400

SECRET_KEY=development-secret-change-me-32-characters
ALGORITHM=HS256
# Session keo dai 7 ngay (7 * 24 * 60)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Google OAuth (Login with Google) ---
# credentials.json service-account KHONG dung duoc cho login.
# Tao OAuth Client ID tren Google Cloud Console va dien vao day.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:3000/api/v1/auth/google/callback

LLM_BASE_URL=http://llama:8012/v1
LLM_MODEL=gemma-4-E2B-it
LLM_API_KEY=
AI_TIMEOUT_SECONDS=300
AI_QUEUE_NAME=ai
AI_OBSERVER_QUEUE_NAME=ai_observer

# --- STT local (khong can API key) ---
STT_PROVIDER=faster_whisper
STT_MODEL_SIZE=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-change-me-32-characters

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eroom
MINIO_SECURE=false

LOG_LEVEL=INFO
