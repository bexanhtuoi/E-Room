# Reverse proxy noi bo cho Tailscale Funnel (TLS ket thuc o Tailscale edge).
# 1 public URL duy nhat: / -> frontend, /api -> api, /rtc* + /validate* -> livekit.
:80 {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle /validate* {
		reverse_proxy livekit:7880
	}

	# Assets hash theo content -> cache 1 nam. HTML (SPA fallback)
	# luon revalidate de deploy moi hien ngay, khoi kẹt ban cu.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy frontend:3000
	}

	handle {
		header Cache-Control "no-cache"
		reverse_proxy frontend:3000
	}
}
