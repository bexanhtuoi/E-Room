# E-Room frontend env — copy thanh `.env` neu can doi default.
# Vite chi nhan bien bat dau bang REACT_APP_ (project retrofit) + VITE_.

# API base: de tuong doi (/api/v1) de chay duoc moi noi (local, LAN, public).
# Vite proxy /api -> http://localhost:8000 khi chay `npm run dev`.
REACT_APP_API_BASE_URL=/api/v1

# HTTPS dev server (can cho mic/cam tren mobile/LAN):
#  - mac dinh (khong set): https bat (chung chi tu ky, browser hoi chap nhan 1 lan)
#  - VITE_HTTPS=off: http thuong (chi dung local)
# VITE_HTTPS=off
