{
  "title": "E-Room API RED",
  "uid": "eroom-red",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "15s",
  "panels": [
    {
      "id": 10,
      "title": "RPS hien tai",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(eroom_http_requests_total[$__rate_interval]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 1, "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 11,
      "title": "Loi hien tai",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Ti le request 4xx+5xx. Xanh = sach, do = co loi.",
      "targets": [
        {
          "expr": "sum(rate(eroom_http_requests_total{status=~\"4..|5..\"}[$__rate_interval])) / sum(rate(eroom_http_requests_total[$__rate_interval]))",
          "legendFormat": "error"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }, { "value": 0.01, "color": "red" }] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }
    },
    {
      "id": 12,
      "title": "Cham p95 hien tai",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "95% request xong trong thoi gian nay. Vuot 2s la bat dau cham.",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(eroom_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }, { "value": 2, "color": "red" }] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 13,
      "title": "Route dang co traffic",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(sum by (route) (rate(eroom_http_requests_total[$__rate_interval])))",
          "legendFormat": "routes"
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "color": { "mode": "thresholds" } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 1,
      "title": "Requests moi giay (theo route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (route) (rate(eroom_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "connectNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "gridPos": { "h": 12, "w": 17, "x": 0, "y": 4 }
    },
    {
      "id": 2,
      "title": "Bang loi (endpoint | ma loi | time)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Loi gan nhat theo tung endpoint. Khong co dong nao = sach.",
      "targets": [
        {
          "expr": "sum by (route, status) (last_over_time(eroom_http_requests_total{status=~\"4..|5..\"}[30m]))",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto" }
        },
        "overrides": []
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Time", "desc": true }] },
      "gridPos": { "h": 12, "w": 7, "x": 17, "y": 4 }
    },
    {
      "id": 3,
      "title": "Do tre p50 (trung vi, theo route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "p50 = mot nua request xong nhanh hon so nay. Day la toc do 'binh thuong' cua he thong.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (route, le) (rate(eroom_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "connectNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 }
    },
    {
      "id": 4,
      "title": "Do tre p95 (da so user chiu, theo route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "p95 = 95% request xong trong X giay, 5% cham hon. Day la con so de cam ket toc do (SLA). p95 leo = he thong bat dau cham.",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(eroom_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }, { "value": 2, "color": "red" }] },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "connectNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 25 }
    },
    {
      "id": 5,
      "title": "Do tre p99 (truong hop xau nhat, theo route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "p99 = 99% request xong trong X giay, 1% te nhat nam ngoai. p99 vot dot ngot = co request ket (DB khoa, AI cham, GC).",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (route, le) (rate(eroom_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "connectNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 34 }
    }
  ]
}
